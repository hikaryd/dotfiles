# Stable personal Codex settings managed by ~/dots.
# Runtime/project/plugin state is intentionally preserved only in ~/.codex/config.toml.
approval_policy = "never"
model = "fixture-model"
service_tier = "default"
model_reasoning_effort = "low"

[shell_environment_policy]
inherit = "core"

[shell_environment_policy.set]
Z_VAR = "${Z_VAR}"
A_VAR = "${A_VAR}"

[mcp_servers."z.first"]
command = "${HOME}/bin/server"
args = ["--token", "${TOKEN}"]
startup_timeout_sec = 15.0
floats = [1000000.0, 1e-05, 0.0001, 1e+16, -0.0, inf, -inf, nan]
records = [{ z = 1, a = 2 }, { a = 3, z = 4 }]

[mcp_servers."z.first".env]
Z_LAST = "${Z_LAST}"
A_FIRST = "${A_FIRST}"

[mcp_servers.alpha]
command = "server"

[mcp_servers.alpha.nested."quoted.field"]
last = true
first = "hello"

[agents]
worker = [{ z = "first", a = 1 }, { a = 2, z = "second" }]

[model_providers.cf-openai]
name = "Fixture provider"
base_url = "${CF_OPENAI_BASE_URL}"
requires_openai_auth = true

[tui]
status_line = ["model"]
