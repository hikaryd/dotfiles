# >>> dots Codex managed root >>>

# Managed settings
model = "fixture-model"
model_reasoning_effort = "high"

# <<< dots Codex managed root <<<

# User preferences
custom_text = """
[mcp_servers.literal]
# >>> dots Codex managed root >>>
# <<< dots Codex managed root <<<
"""
local_inline = { zebra = 1, alpha = 2 }
local_array = [
  { description = '[not.a.table]', value = 1 },
  { value = 2, description = '# <<< dots Codex managed root <<<' },
]

[projects."/fixture/project.with.dots"] # user table
trust_level = 'trusted' # keep trailing comment

[[user_records]]
label = "one"

[[user_records]]
label = "two"

[mcp_servers."keep.secret"]
command = 'old-command'

[mcp_servers."keep.secret".env]
TOKEN = 'fake-existing-secret'

[agents]
# >>> dots Codex managed table >>>
max_threads = 6
# <<< dots Codex managed table <<<

[tui]
# >>> dots Codex managed keys >>>
status_line = ["model", "context"]
# <<< dots Codex managed keys <<<
# User-owned display choice
notifications = false
custom_message = '''
# >>> dots Codex managed keys >>>
# <<< dots Codex managed keys <<<
[mcp_servers.fake]
'''
