#!/bin/bash
# Ayu [[.variant]] — generated from palette/ayu.toml

export BAR_COLOR=[[argb .editor.bg "f0"]]
export BAR_BORDER_COLOR=0x00000000

export WHITE=0xffffffff
export BLACK=0xff000000
export TRANSPARENT=0x00000000

# Text/icon colors
export ICON_COLOR=[[argb .editor.fg "ff"]]
export LABEL_COLOR=[[argb .editor.fg "ff"]]

# Subtle backgrounds
export ITEM_BG_COLOR=[[argb .ui.selection "44"]]
export ACCENT_COLOR=[[argb .common.accent "ff"]]
export HIGHLIGHT=[[argb .ui.selection "66"]]

# Semantic colors
export RED=[[argb .common.error "ff"]]
export GREEN=[[argb .terminal.green "ff"]]
export BLUE=[[argb .terminal.blue "ff"]]
export YELLOW=[[argb .common.warning "ff"]]
export ORANGE=[[argb .syntax.operator "ff"]]
export MAGENTA=[[argb .terminal.magenta "ff"]]
export CYAN=[[argb .terminal.cyan "ff"]]

# Popup
export POPUP_BACKGROUND_COLOR=[[argb .editor.bg "e0"]]
export POPUP_BORDER_COLOR=[[argb .ui.border "44"]]

export SHADOW_COLOR=$BLACK
