{
        "manifest_version": 3,
        "version": "1.0",
        "name": "Ayu [[.title]]",
        "description": "Ayu [[.variant]] theme — generated from palette/ayu.toml",
        "theme": {
            "colors": {
                "frame": [[rgb .editor.bg]],
                "frame_inactive": [[rgb .editor.bg]],
                "frame_incognito": [[rgb .editor.bg]],
                "frame_incognito_inactive": [[rgb .editor.bg]],
                "toolbar": [[rgb .editor.line]],
                "tab_text": [[rgb .editor.fg]],
                "tab_background_text": [[rgb .ui.fg]],
                "tab_background_text_inactive": [[rgb .ui.fg]],
                "bookmark_text": [[rgb .editor.fg]],
                "ntp_background": [[rgb .editor.bg]],
                "ntp_text": [[rgb .editor.fg]],
                "ntp_link": [[rgb .common.accent]],
                "ntp_header": [[rgb .ui.line]],
                "button_background": [0, 0, 0, 0],
                "omnibox_background": [[rgb .editor.bg]],
                "omnibox_text": [[rgb .editor.fg]]},
            "tints": {
                "frame_inactive": [-1, -1, 0.7]},
            "properties": {
                "ntp_background_alignment": "center"}}}