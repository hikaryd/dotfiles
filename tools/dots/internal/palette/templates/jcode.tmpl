# Generated by dots-tools palette from palette/ayu.toml (Ayu [[.title]]).
# jcode inherits the overall background from the terminal.
[display]
theme = "dark"

[display.colors]
user = "[[.common.accent]]"
ai = "[[.syntax.string]]"
tool = "[[.common.accent]]"
file_link = "[[.syntax.tag]]"
dim = "[[.ui.fg]]"
accent = "[[.common.accent]]"
system = "[[.syntax.constant]]"
queued = "[[.common.warning]]"
asap = "[[.common.error]]"
pending = "[[.common.warning]]"
user_text = "[[.editor.fg]]"
user_bg = "[[.editor.line]]"
ai_text = "[[.editor.fg]]"
header_icon = "[[.common.accent]]"
header_name = "[[.editor.fg]]"
header_session = "[[.ui.fg]]"
success = "[[.syntax.string]]"
warning = "[[.common.warning]]"
error = "[[.common.error]]"
info = "[[.syntax.tag]]"
border = "[[.ui.border]]"
selection_bg = "[[.ui.selection]]"
