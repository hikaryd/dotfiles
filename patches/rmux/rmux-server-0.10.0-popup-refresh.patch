+#[tokio::test]
+async fn one_shot_popup_refresh_captures_current_menu_without_polluting_base() {
+    let handler = RequestHandler::new();
+    let alpha = session_name("one-shot-current-menu");
+    let pid = std::process::id();
+    let mut control_rx = create_quiet_attached_session(&handler, &alpha, pid).await;
+    run_overlay_command(
+        &handler,
+        pid,
+        r#"display-menu -T Menu "First" "f" "refresh-client""#,
+    )
+    .await;
+    let _ = next_overlay_frame(&mut control_rx).await;
+    while control_rx.try_recv().is_ok() {}
+    let (identity, session_id, generation) = {
+        let attached = handler.active_attach.lock().await;
+        let active = &attached.by_pid[&pid];
+        (
+            active.identity(pid),
+            active.session_id,
+            active.overlay_generation,
+        )
+    };
+    assert!(
+        handler
+            .refresh_attached_client_base_for_session_identity(identity, &alpha, session_id)
+            .await
+    );
+    let mut saw_switch = false;
+    while let Ok(control) = control_rx.try_recv() {
+        if let AttachControl::Switch(target) = control {
+            let target = target.into_target();
+            assert!(!String::from_utf8_lossy(&target.render_frame).contains("First"));
+            let overlay = target.refresh_overlay_frame.expect("one-shot current menu");
+            assert!(String::from_utf8_lossy(&overlay.frame).contains("First"));
+            assert_eq!(overlay.overlay_generation, generation);
+            saw_switch = true;
+        }
+    }
+    assert!(saw_switch);
+    assert_eq!(
+        handler.active_attach.lock().await.by_pid[&pid].overlay_generation,
+        generation
+    );
+}
