+async fn one_shot_popup_rejects_a_base_snapshot_captured_before_resize() {
+    for session_refresh in [false, true] {
+        let handler = RequestHandler::new();
+        let alpha = session_name(if session_refresh {
+            "one-shot-resize-session"
+        } else {
+            "one-shot-resize-client"
+        });
+        let pid = if session_refresh { 61_189 } else { 61_188 };
+        let mut controls = create_quiet_attached_session(&handler, &alpha, pid).await;
+        run_overlay_command(
+            &handler,
+            pid,
+            r#"display-menu -T Menu "First" "f" "refresh-client""#,
+        )
+        .await;
+        let _ = next_overlay_frame(&mut controls).await;
+        while controls.try_recv().is_ok() {}
+        let pause = crate::handler::attach_support::install_generic_render_delivery_pause(pid);
+        let refresh_handler = handler.clone();
+        let refresh_session = alpha.clone();
+        let refresh = tokio::spawn(async move {
+            if session_refresh {
+                refresh_handler
+                    .refresh_attached_session(&refresh_session)
+                    .await;
+            } else {
+                refresh_handler
+                    .refresh_attached_client(pid, &refresh_session)
+                    .await;
+            }
+        });
+        timeout(Duration::from_secs(2), pause.reached.notified())
+            .await
+            .expect("delivery pause");
+        handler
+            .handle_attached_resize(
+                pid,
+                TerminalSize {
+                    cols: 100,
+                    rows: 30,
+                },
+            )
+            .await
+            .expect("resize");
+        while controls.try_recv().is_ok() {}
+        pause.release.notify_one();
+        refresh.await.expect("refresh task");
+        while let Ok(control) = controls.try_recv() {
+            assert!(
+                !matches!(control, AttachControl::Switch(_)),
+                "old-size base must not be delivered after resize"
+            );
+        }
+    }
+}
