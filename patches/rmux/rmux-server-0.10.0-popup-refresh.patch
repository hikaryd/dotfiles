+#[tokio::test]
+async fn one_shot_popup_final_delivery_observes_close_or_replacement_in_order() {
+    for replace in [false, true] {
+        let handler = RequestHandler::new();
+        let alpha = session_name(if replace {
+            "one-shot-replace"
+        } else {
+            "one-shot-close"
+        });
+        let pid = if replace { 61_191 } else { 61_190 };
+        let mut controls = create_quiet_attached_session(&handler, &alpha, pid).await;
+        run_overlay_command(&handler, pid, r#"display-popup -N -T FIRST -w 20 -h 6"#).await;
+        let _ = next_overlay_frame(&mut controls).await;
+        while controls.try_recv().is_ok() {}
+        let pause = crate::handler::attach_support::install_generic_render_delivery_pause(pid);
+        let refresh_handler = handler.clone();
+        let refresh_session = alpha.clone();
+        let refresh = tokio::spawn(async move {
+            refresh_handler
+                .refresh_attached_client(pid, &refresh_session)
+                .await;
+        });
+        timeout(Duration::from_secs(2), pause.reached.notified())
+            .await
+            .expect("delivery pause");
+        handler
+            .clear_interactive_overlay(pid, true)
+            .await
+            .expect("close FIRST");
+        if replace {
+            run_overlay_command(&handler, pid, r#"display-popup -N -T SECOND -w 20 -h 6"#).await;
+        }
+        pause.release.notify_one();
+        refresh.await.expect("refresh task");
+        let mut saw_clear = false;
+        let mut saw_replacement = false;
+        let mut saw_switch = false;
+        while let Ok(control) = controls.try_recv() {
+            match control {
+                AttachControl::Overlay(overlay)
+                    if overlay.persistent && overlay.frame.is_empty() =>
+                {
+                    assert!(
+                        !saw_replacement,
+                        "old clear must precede replacement delivery"
+                    );
+                    saw_clear = true;
+                }
+                AttachControl::Overlay(overlay)
+                    if String::from_utf8_lossy(&overlay.frame).contains("SECOND") =>
+                {
+                    assert!(saw_clear);
+                    saw_replacement = true;
+                }
+                AttachControl::Switch(target) => {
+                    let target = target.into_target();
+                    assert!(!String::from_utf8_lossy(&target.render_frame).contains("FIRST"));
+                    if replace {
+                        let overlay = target
+                            .refresh_overlay_frame
+                            .expect("latest replacement captured");
+                        let frame = String::from_utf8_lossy(&overlay.frame);
+                        assert!(frame.contains("SECOND"));
+                        assert!(!frame.contains("FIRST"));
+                    } else {
+                        assert!(
+                            target.refresh_overlay_frame.is_none(),
+                            "closed popup must not be captured"
+                        );
+                    }
+                    saw_switch = true;
+                }
+                _ => {}
+            }
+        }
+        assert!(saw_clear && saw_switch);
+        assert_eq!(saw_replacement, replace);
+    }
+}
+
