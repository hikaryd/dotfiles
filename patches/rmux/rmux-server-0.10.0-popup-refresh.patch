@@ -1,5 +1,108 @@
 use super::*;
 
+#[tokio::test]
+async fn one_shot_popup_pending_control_composes_without_polluting_base() {
+    let alpha = SessionName::new("one-shot-pending").expect("session name");
+    let (stream, mut peer) = tokio::net::UnixStream::pair().expect("stream pair");
+    let stream = AttachTransport::from(stream);
+    let (control_tx, mut control_rx) = mpsc::unbounded_channel();
+    let mut current = open_attach_target(test_attach_target(&alpha, b"BASE-OLD", None), false)
+        .expect("open target");
+    let mut next = test_render_only_attach_target(&alpha, b"BASE-NEW");
+    next.refresh_overlay_frame = Some(OverlayFrame::persistent(b"POPUP".to_vec(), 1, 2));
+    control_tx
+        .send(AttachControl::switch(next))
+        .expect("switch");
+    let mut render_generation = 0;
+    let mut overlay_generation = 0;
+    let mut cache = None;
+    let mut visible = false;
+    let mut state_id = None;
+    let mut locked = false;
+    let mut deferred = VecDeque::new();
+    apply_pending_attach_controls(
+        &mut deferred,
+        Some(&mut control_rx),
+        &AtomicUsize::new(0),
+        &mut current,
+        &stream,
+        &mut render_generation,
+        &mut overlay_generation,
+        &mut cache,
+        &mut visible,
+        &mut state_id,
+        &mut locked,
+        None,
+    )
+    .await
+    .expect("apply switch");
+    let bytes = read_attach_data_until(&mut peer, b"BASE-NEW").await;
+    assert!(bytes.windows(13).any(|bytes| bytes == b"BASE-NEWPOPUP"));
+    assert_eq!(current.render_frame, b"BASE-NEW");
+    assert_eq!(cache.as_deref(), Some(b"POPUP".as_slice()));
+    assert!(visible);
+    assert_eq!(overlay_generation, 2);
+
+    control_tx
+        .send(AttachControl::Overlay(OverlayFrame::persistent(
+            Vec::new(),
+            1,
+            3,
+        )))
+        .expect("clear");
+    apply_pending_attach_controls(
+        &mut deferred,
+        Some(&mut control_rx),
+        &AtomicUsize::new(0),
+        &mut current,
+        &stream,
+        &mut render_generation,
+        &mut overlay_generation,
+        &mut cache,
+        &mut visible,
+        &mut state_id,
+        &mut locked,
+        None,
+    )
+    .await
+    .expect("apply clear");
+    let bytes = read_attach_data_until(&mut peer, b"BASE-NEW").await;
+    assert!(!bytes.windows(5).any(|bytes| bytes == b"POPUP"));
+    assert!(cache.is_none());
+    assert!(!visible);
+}
+
+#[tokio::test]
+async fn one_shot_popup_forward_attach_composes_without_separate_overlay() {
+    let handler = Arc::new(RequestHandler::new());
+    let alpha = SessionName::new("one-shot-forward").expect("session name");
+    let (stream, mut peer) = tokio::net::UnixStream::pair().expect("stream pair");
+    let (shutdown_tx, shutdown_rx) = watch::channel(());
+    let (control_tx, control_rx) = mpsc::unbounded_channel();
+    let task = tokio::spawn(forward_attach(
+        stream,
+        test_attach_target(&alpha, b"BASE-OLD", None),
+        Vec::new(),
+        shutdown_rx,
+        control_rx,
+        Arc::new(AtomicUsize::new(0)),
+        Arc::new(AtomicBool::new(false)),
+        Arc::new(AtomicU64::new(0)),
+        LiveAttachInputContext::unregistered_for_test(handler, std::process::id()),
+        false,
+    ));
+    let _ = read_attach_data_until(&mut peer, b"BASE-OLD").await;
+    let mut next = test_render_only_attach_target(&alpha, b"BASE-NEW");
+    next.refresh_overlay_frame = Some(OverlayFrame::persistent(b"POPUP".to_vec(), 1, 1));
+    control_tx
+        .send(AttachControl::switch(next))
+        .expect("switch");
+    let bytes = read_attach_data_until(&mut peer, b"BASE-NEW").await;
+    shutdown_tx.send(()).expect("shutdown");
+    task.await.expect("join").expect("attach result");
+    assert!(bytes.windows(13).any(|bytes| bytes == b"BASE-NEWPOPUP"));
+}
