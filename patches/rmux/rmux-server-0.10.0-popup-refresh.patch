+#[test]
+fn one_shot_popup_coalescing_keeps_the_chosen_targets_own_payload() {
+    let (inner, mut receiver) = mpsc::unbounded_channel();
+    let sender = AttachControlSender::new(
+        inner,
+        Arc::new(AtomicUsize::new(0)),
+        64,
+        Arc::new(AtomicBool::new(false)),
+    );
+    let output = pane_output_channel();
+    for marker in 1..=2 {
+        let mut target = deep_coalescible_target(&output, marker, 8);
+        target.live_pane = None;
+        target.refresh_overlay_frame = Some(OverlayFrame::persistent(
+            vec![marker],
+            marker.into(),
+            marker.into(),
+        ));
+        sender
+            .send(AttachControl::switch(target))
+            .expect("refresh fits");
+    }
+    let AttachControl::Switch(queued) = receiver.try_recv().expect("switch") else {
+        panic!("expected switch");
+    };
+    let (target, count) = queued.into_target_with_count();
+    assert_eq!(count, 2);
+    assert_eq!(target.render_frame, vec![2; 8]);
+    let overlay = target.refresh_overlay_frame.expect("chosen payload");
+    assert_eq!(overlay.frame, vec![2]);
+    assert_eq!(overlay.render_generation, 2);
+}
