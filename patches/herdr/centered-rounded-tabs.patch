@@ -1,5 +1,19 @@
 use super::*;
 
+#[test]
+fn tab_group_is_centered_and_uses_rounded_caps() {
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(Box::new(snapshot()));
+    state.set_pane_surface(surface());
+    let frame = state.compose(100, 20).expect("tab bar frame");
+    let tab = state.hits.tabs[0].0;
+    let first = &frame.cells[tab.x as usize];
+    let last = &frame.cells[(tab.right() - 1) as usize];
+    assert_eq!(first.symbol, "");
+    assert_eq!(last.symbol, "");
+    assert!(tab.x > 30 && tab.right() < 70, "tab rect: {tab:?}");
+}
