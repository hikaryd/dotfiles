#!/bin/sh
# Harness-only proxy; no shell startup or system proxy changes.
set -eu
"$HOME/.local/bin/dots-tools" proxy pi --ensure </dev/null >&2
proxy='http://127.0.0.1:10810'
bypass="127.0.0.1,localhost,::1,*.local${NO_PROXY:+,$NO_PROXY}${no_proxy:+,$no_proxy}"
export HTTP_PROXY="$proxy" HTTPS_PROXY="$proxy" ALL_PROXY="$proxy"
export http_proxy="$proxy" https_proxy="$proxy" all_proxy="$proxy"
export WS_PROXY="$proxy" WSS_PROXY="$proxy" ws_proxy="$proxy" wss_proxy="$proxy"
export NO_PROXY="$bypass" no_proxy="$bypass" JCODE_NO_TELEMETRY=1
export JCODE_DISABLE_CLAUDE_MCP=1
# Jcode tools use noninteractive bash, not the harness proxy environment.
if [ "${BASH_ENV:-}" != "$HOME/.config/jcode/shell-env.sh" ]; then
  export JCODE_PREVIOUS_BASH_ENV="${BASH_ENV:-}"
fi
export BASH_ENV="$HOME/.config/jcode/shell-env.sh"
exec "$HOME/.jcode/builds/stable/jcode" "$@"
