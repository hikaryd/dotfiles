{
  "mcpServers": {
    "serena": {
      "command": "@DATA@/python/serena-agent/bin/serena",
      "args": ["start-mcp-server", "--context", "codex", "--agent-interface", "tools", "--language-backend", "LSP", "--project-from-cwd", "--enable-web-dashboard", "false", "--open-web-dashboard", "false", "--enable-gui-log-window", "false"],
      "env": {"SERENA_HOME": "@DATA@/serena", "PATH": "@PATH@"}
    },
    "context7": {
      "command": "@NODE@",
      "args": ["@DATA@/runtime/node_modules/@upstash/context7-mcp/dist/index.js"]
    },
    "deepwiki": {
      "command": "@NODE@",
      "args": ["@DATA@/runtime/node_modules/mcp-remote/dist/proxy.js", "https://mcp.deepwiki.com/mcp"],
      "env": {"MCP_REMOTE_CONFIG_DIR": "@DATA@/mcp-remote"}
    },
    "code-graph": {
      "command": "@DATA@/python/codegraphcontext/bin/cgc",
      "args": ["--database", "neo4j", "mcp", "start"],
      "env": {"DEFAULT_DATABASE": "neo4j", "CGC_IGNORE_PROJECT_ENV": "1", "NEO4J_URI": "bolt://127.0.0.1:7687", "NEO4J_USERNAME": "neo4j", "NEO4J_PASSWORD": "@NEO4J_PASSWORD@", "NEO4J_DATABASE": "neo4j", "PATH": "@PATH@"}
    },
    "neo4j-cypher": {
      "command": "@DATA@/python/mcp-neo4j-cypher/bin/mcp-neo4j-cypher",
      "args": ["--transport", "stdio"],
      "env": {"NEO4J_URL": "bolt://127.0.0.1:7687", "NEO4J_USERNAME": "neo4j", "NEO4J_PASSWORD": "@NEO4J_PASSWORD@", "NEO4J_DATABASE": "neo4j"}
    },
    "neo4j-memory": {
      "command": "@DATA@/python/mcp-neo4j-memory/bin/mcp-neo4j-memory",
      "args": ["--transport", "stdio"],
      "env": {"NEO4J_URL": "bolt://127.0.0.1:7687", "NEO4J_USERNAME": "neo4j", "NEO4J_PASSWORD": "@NEO4J_PASSWORD@", "NEO4J_DATABASE": "neo4j"}
    },
    "piweb": {
      "command": "@NODE@",
      "args": ["@DATA@/runtime/node_modules/pi-web-access/dist/mcp-cli.js"],
      "env": {"PI_CODING_AGENT_DIR": "@DATA@/web/config"}
    }
  }
}
