{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": "",
    "size": {
        "binaryPrefix": "si",
      "ndigits": 0
    },
    "percent": {
      "type": 1
    },
    "key":{
     "Width": 1
     }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "#ffc799",
        "host": "#a0a0a0"
      }
    },
    {
      "type": "separator",
      "string": "▔"
    },
    {
      "type": "os",
      "key": "╭─ ",
      "format": "{3} ({12})",
      "keyColor": "#ffc799"
    },
    {
      "type": "host",
      "key": "├─󰟀 ",
      "keyColor": "#ffc799"
    },
    {
      "type": "kernel",
      "key": "├─󰒔 ",
      "format": "{1} {2}",
      "keyColor": "#ffc799"
    },
    {
      "type": "shell",
      "key": "├─$ ",
      "format": "{1} {4}",
      "keyColor": "#ffc799"
    },
    {
      "type": "packages",
      "key": "├─ ",
      "keyColor": "#ffc799"
    },
    {
      "type": "uptime",
      "key": "╰─󰔚 ",
      "keyColor": "#ffc799"
    },
    "break",
    {
      "type": "display",
      "key": "╭─󰹑 ",
      "keyColor": "#ffc799",
      "compactType": "original"
    },
    {
      "type": "de",
      "key": "├─󰧨 ",
      "keyColor": "#ffc799"
    },
    {
      "type": "wm",
      "key": "├─ ",
      "keyColor": "#ffc799"
    },
    {
      "type": "theme",
      "key": "├─󰉼 ",
      "keyColor": "#ffc799"
    },
    {
      "type": "icons",
      "key": "├─ ",
      "keyColor": "#ffc799"
    },
    {
      "type": "cursor",
      "key": "├─󰳽 ",
      "keyColor": "#ffc799"
    },
    {
      "type": "font",
      "key": "├─ ",
      "format": "{2}",
      "keyColor": "#ffc799"
    },
    {
      "type": "terminal",
      "key": "╰─ ",
      "format": "{3}",
      "keyColor": "#ffc799"
    },
    "break",
    {
      "type": "colors",
      "symbol": "block"
    }
  ]
}
