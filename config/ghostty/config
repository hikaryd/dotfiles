background = 101010
foreground = ececec
selection-background = 2a2a2a
selection-foreground = ececec
cursor-color = ffc799
unfocused-split-fill = 101010
palette = 0=#1c1c1c
palette = 1=#ff8080
palette = 2=#8fd3a5
palette = 3=#ffc799
palette = 4=#8fb4e0
palette = 5=#c8a8e0
palette = 6=#6fd1c4
palette = 7=#cfcfcf
palette = 8=#5c5c5c
palette = 9=#ffa3a3
palette = 10=#b3e8c2
palette = 11=#ffd9b8
palette = 12=#b0cdef
palette = 13=#dcc5ef
palette = 14=#99ffe4
palette = 15=#ffffff
# Терминалы открывают постоянные сессии tmux.
command = shell:"$HOME/.local/bin/dots-terminal"
# The outer command is tmux, not Nu. Nushell runs in its panes, so Ghostty
# must not append its Nushell --execute bootstrap to the mux CLI.
shell-integration = none


# Встроенный JetBrains Mono с Nerd-иконками: отдельный шрифт не нужен.
font-size = 15
adjust-cell-height = 12%
# Операторы остаются отдельными символами, без декоративных лигатур.
font-feature = -calt, -liga, -dlig

# Контракт цветового пространства для macOS-шейдера курсора.
window-colorspace = display-p3
alpha-blending = native
unfocused-split-opacity = 0.94
background-opacity = 0.94
# Графитовое стекло: blur убирает детали за окном, оставляя ощущение глубины.
background-blur = 18

macos-titlebar-style = hidden
window-padding-balance = true
window-padding-x = 18
window-padding-y = 14

title =

split-divider-color = 282828
# Тусклый текст (подсказки, autosuggest) читается, но остаётся вторичным.
faint-opacity = 0.6
# Иконка Dock в цветах палитры.
macos-icon = custom-style
macos-icon-frame = chrome
macos-icon-ghost-color = ffc799
macos-icon-screen-color = 101010,1c1c1c

cursor-style = bar
cursor-style-blink = false
adjust-cursor-thickness = 2
cursor-text = cell-background
cursor-opacity = 1

mouse-hide-while-typing = true

shell-integration-features = no-cursor

confirm-close-surface = false

macos-option-as-alt = false
# Option+Delete удаляет слово в Nu и агентах через мультиплексор.
# Явный Alt+Backspace не затрагивает остальные Option-сочетания и не посылает Ctrl+W.
keybind = alt+backspace=text:\x1b\x7f

# Ctrl-команды по физическим клавишам: одинаковые коды в латинской и русской раскладках.
# Для второй клавиши префикса tmux.conf содержит явные русские эквиваленты.
keybind = ctrl+key_a=text:\x01
keybind = ctrl+key_h=text:\x08
keybind = ctrl+key_j=text:\x0a
keybind = ctrl+key_k=text:\x0b
keybind = ctrl+key_l=text:\x0c
keybind = ctrl+key_n=text:\x0e
keybind = ctrl+key_p=text:\x10
keybind = ctrl+key_v=text:\x16
keybind = ctrl+key_w=text:\x17
keybind = ctrl+shift+key_h=csi:104;6u
keybind = ctrl+shift+key_j=csi:106;6u
keybind = ctrl+shift+key_k=csi:107;6u
keybind = ctrl+shift+key_l=csi:108;6u

# Pass ctrl+number to tmux (CSI u encoding).
keybind = ctrl+1=csi:49;5u
keybind = ctrl+2=csi:50;5u
keybind = ctrl+3=csi:51;5u
keybind = ctrl+4=csi:52;5u
keybind = ctrl+5=csi:53;5u
keybind = ctrl+6=csi:54;5u
keybind = ctrl+7=csi:55;5u
keybind = ctrl+8=csi:56;5u
keybind = ctrl+9=csi:57;5u

# Без декоративного следа и постоянной перерисовки в покое.
custom-shader =
custom-shader-animation = false

# Локальные профили dots style, относительно XDG-конфига Ghostty.
config-file = ?../dots/ghostty-style.conf
