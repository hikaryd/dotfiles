background = 101010
foreground = ffffff
selection-background = 232323
selection-foreground = ffffff
cursor-color = ffc799
unfocused-split-fill = 101010
palette = 0=#181818
palette = 1=#ff8080
palette = 2=#50b5aa
palette = 3=#ffc799
palette = 4=#b0b0b0
palette = 5=#ffc799
palette = 6=#50b5aa
palette = 7=#dadada
palette = 8=#505050
palette = 9=#ff8080
palette = 10=#99ffe4
palette = 11=#ffcfa8
palette = 12=#b0b0b0
palette = 13=#ffcfa8
palette = 14=#99ffe4
palette = 15=#ffffff
# Терминалы открывают постоянные сессии rmux.
command = shell:"$HOME/.local/bin/dots-terminal"
# The outer command is rmux, not Nu. Nushell runs in its panes, so Ghostty
# must not append its Nushell --execute bootstrap to the mux CLI.
shell-integration = none


font-family = Hack Nerd Font Mono
font-size = 15
adjust-cell-height = 12%
# Операторы остаются отдельными символами, без декоративных лигатур.
font-feature = -calt, -liga, -dlig

# Контракт цветового пространства для macOS-шейдера курсора.
window-colorspace = display-p3
alpha-blending = native
unfocused-split-opacity = 0.94
background-opacity = 0.94
# Графитовое стекло: blur убирает детали за окном, оставляя ощущение глубины.
background-blur = 18

macos-titlebar-style = hidden
window-padding-balance = true
window-padding-x = 18
window-padding-y = 14

title =

cursor-style = bar
cursor-style-blink = false
cursor-text = cell-background
cursor-opacity = 1

mouse-hide-while-typing = true

shell-integration-features = no-cursor

confirm-close-surface = false

macos-option-as-alt = false
# Option+Delete удаляет слово в Nu и агентах через мультиплексор.
# Явный Alt+Backspace не затрагивает остальные Option-сочетания и не посылает Ctrl+W.
keybind = alt+backspace=text:\x1b\x7f

# Ctrl-команды по физическим клавишам: одинаковые коды в латинской и русской раскладках.
# Для второй клавиши префикса rmux содержит явные русские эквиваленты.
keybind = ctrl+key_a=text:\x01
keybind = ctrl+key_h=text:\x08
keybind = ctrl+key_j=text:\x0a
keybind = ctrl+key_k=text:\x0b
keybind = ctrl+key_l=text:\x0c
keybind = ctrl+key_n=text:\x0e
keybind = ctrl+key_p=text:\x10
keybind = ctrl+key_v=text:\x16
keybind = ctrl+key_w=text:\x17
keybind = ctrl+shift+key_h=csi:104;6u
keybind = ctrl+shift+key_j=csi:106;6u
keybind = ctrl+shift+key_k=csi:107;6u
keybind = ctrl+shift+key_l=csi:108;6u

# Pass ctrl+number to rmux/tmux (CSI u encoding).
keybind = ctrl+1=csi:49;5u
keybind = ctrl+2=csi:50;5u
keybind = ctrl+3=csi:51;5u
keybind = ctrl+4=csi:52;5u
keybind = ctrl+5=csi:53;5u
keybind = ctrl+6=csi:54;5u
keybind = ctrl+7=csi:55;5u
keybind = ctrl+8=csi:56;5u
keybind = ctrl+9=csi:57;5u

# Без декоративного следа и постоянной перерисовки в покое.
custom-shader =
custom-shader-animation = false

# Локальные профили dots style, относительно XDG-конфига Ghostty.
config-file = ?../dots/ghostty-style.conf
