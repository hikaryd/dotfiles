theme = Ayu

# Нейтральная рабочая типографика; иконки — отдельным fallback.
font-family = SF Mono
font-family = Symbols Nerd Font Mono
font-size = 15
adjust-cell-height = 12%
# Операторы остаются отдельными символами, без декоративных лигатур.
font-feature = -calt, -liga, -dlig

background = 0d1017
foreground = bfbdb6
# Контракт цветового пространства для macOS-шейдера курсора.
window-colorspace = display-p3
alpha-blending = native
selection-background = 273747
selection-foreground = bfbdb6
unfocused-split-opacity = 0.94
unfocused-split-fill = 0d1017
background-opacity = 0.94
# Графитовое стекло: blur убирает детали за окном, оставляя ощущение глубины.
background-blur = 18

macos-titlebar-style = hidden
window-padding-balance = true
window-padding-x = 18
window-padding-y = 14

title =

cursor-style = bar
cursor-style-blink = false
cursor-color = 73d0ff
cursor-text = cell-background
cursor-opacity = 1

mouse-hide-while-typing = true

shell-integration-features = no-cursor

confirm-close-surface = false

macos-option-as-alt = false

# ── Pass ctrl+number to tmux (CSI u encoding) ──
keybind = ctrl+1=csi:49;5u
keybind = ctrl+2=csi:50;5u
keybind = ctrl+3=csi:51;5u
keybind = ctrl+4=csi:52;5u
keybind = ctrl+5=csi:53;5u
keybind = ctrl+6=csi:54;5u
keybind = ctrl+7=csi:55;5u
keybind = ctrl+8=csi:56;5u
keybind = ctrl+9=csi:57;5u

# Короткий след дополняет нативный курсор, не двигая текст.
# Для полного отключения движения уберите следующую строку custom-shader.
custom-shader = shaders/smooth_cursor.glsl
custom-shader-animation = true

# Локальные профили dots style, относительно XDG-конфига Ghostty.
config-file = ?../dots/ghostty-style.conf
