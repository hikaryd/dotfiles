theme = Ayu

font-family = Iosevka
font-size = 14
adjust-cell-height = 45%

background = 0d1017
background-opacity = 0.95
# Blur is handled by WindowServer and is disproportionately expensive while
# animated shaders are active. Transparency stays enabled without the blur pass.
background-blur = false

macos-titlebar-style = hidden
window-padding-balance = true
window-padding-x = 6
window-padding-y = 6

title =

cursor-style = block
cursor-style-blink = false
cursor-color = 73d0ff
cursor-text = cell-background
cursor-opacity = 0

mouse-hide-while-typing = true

shell-integration-features = no-cursor

confirm-close-surface = false

macos-option-as-alt = false

# ── Pass ctrl+number to tmux (CSI u encoding) ──
keybind = ctrl+1=csi:49;5u
keybind = ctrl+2=csi:50;5u
keybind = ctrl+3=csi:51;5u
keybind = ctrl+4=csi:52;5u
keybind = ctrl+5=csi:53;5u
keybind = ctrl+6=csi:54;5u
keybind = ctrl+7=csi:55;5u
keybind = ctrl+8=csi:56;5u
keybind = ctrl+9=csi:57;5u

# Input effects run before the synthetic caret so the cursor stays crisp.
custom-shader = shaders/input_motion.glsl
custom-shader = shaders/smooth_cursor.glsl
custom-shader-animation = true
