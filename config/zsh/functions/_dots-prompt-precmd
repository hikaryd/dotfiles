local command_status=$?
local head branch='' duration='' virtualenv='' prompt_line
local -F 2 elapsed

# Repository discovery only repeats after changing directory. HEAD itself is a
# tiny file and is read on every prompt so checkout/switch updates immediately.
if [[ "${_dots_prompt_pwd:-}" != "$PWD" ]]; then
  typeset -g _dots_prompt_pwd="$PWD"
  _dots-prompt-find-git-dir
  typeset -g _dots_prompt_git_dir="$REPLY"
fi

if [[ -n "${_dots_prompt_git_dir:-}" && -r "$_dots_prompt_git_dir/HEAD" ]]; then
  IFS= read -r head < "$_dots_prompt_git_dir/HEAD"
  if [[ "$head" == 'ref: refs/heads/'* ]]; then
    branch="${head#ref: refs/heads/}"
  elif [[ -n "$head" ]]; then
    branch="${head[1,7]}"
  fi
fi

if (( ${+_dots_prompt_command_started} )); then
  (( elapsed = EPOCHREALTIME - _dots_prompt_command_started ))
  unset _dots_prompt_command_started
  (( elapsed >= 3.0 )) && printf -v duration '%.0fs' "$elapsed"
fi

[[ -n "${VIRTUAL_ENV:-}" ]] && virtualenv="${VIRTUAL_ENV:t}"
branch="${branch//\%/%%}"
virtualenv="${virtualenv//\%/%%}"
# .zshrc включает PROMPT_SUBST: текст из репозитория (ветка вида $(cmd)) нельзя вставлять
# в PROMPT напрямую. Ссылка на переменную подставляет значение один раз, без вычисления.
typeset -g _dots_prompt_branch="$branch" _dots_prompt_venv="$virtualenv"
if [[ -o prompt_subst ]]; then
  [[ -n "$branch" ]] && branch='${_dots_prompt_branch}'
  [[ -n "$virtualenv" ]] && virtualenv='${_dots_prompt_venv}'
fi

prompt_line="%F{${dots_color[muted]}}󰀵 %f%F{${dots_color[fg]}}%5~ %f"
[[ -n "$branch" ]] && prompt_line+="%F{${dots_color[hint]}}󰘬 ${branch} %f"
[[ -n "$virtualenv" ]] && prompt_line+="%F{${dots_color[string]}}${virtualenv} %f"
[[ -n "$duration" ]] && prompt_line+="%F{${dots_color[muted]}}${duration} %f"
# Только builtin read: профиль меняется на следующем prompt без перезапуска.
local dots_style='glass'
local style_file="${XDG_CONFIG_HOME:-$HOME/.config}/dots/style"
[[ -r "$style_file" ]] && IFS= read -r dots_style < "$style_file"
if [[ "$dots_style" == presentation ]]; then
  prompt_line="%F{${dots_color[fg]}}PRESENTATION%f "
  [[ -n "$duration" ]] && prompt_line+="%F{${dots_color[muted]}}${duration} %f"
fi
# Состояние команды различимо и символом, и цветом; без внешних процессов.
if (( command_status )); then
  PROMPT="${prompt_line}"$'\n'"%F{${dots_color[error]}}!%f "
else
  PROMPT="${prompt_line}"$'\n'"%F{${dots_color[accent]}}>%f "
fi
