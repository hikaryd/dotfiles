[Unit]
Description=Expire Pixel Chrome tabs after 12 observed hours
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/pixel-tab-cleaner/tab_cleaner.py
DynamicUser=yes
StateDirectory=pixel-tab-cleaner
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32
SocketBindDeny=any
MemoryMax=64M
TasksMax=8
TimeoutStartSec=240
