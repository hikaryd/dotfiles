#!/usr/bin/env python3
"""Запуск Nushell с кэшируемыми ссылками на существующие команды zsh."""

import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path


def private_dir(path):
    if path.is_symlink():
        raise RuntimeError("Каталог команд не должен быть символической ссылкой")
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    path.chmod(0o700)


def init_atuin():
    atuin = shutil.which("atuin")
    if not atuin:
        return
    if sys.platform == "darwin":
        home = Path.home() / "Library/Application Support"
    else:
        home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    autoload = home / "nushell/autoload"
    target = autoload / "80-dots-atuin.nu"
    if target.exists() or target.is_symlink():
        return
    result = subprocess.run(
        [atuin, "init", "nu", "--disable-up-arrow", "--disable-ai"],
        capture_output=True,
        check=False,
    )
    if result.returncode or not result.stdout:
        return
    autoload.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".atuin-", dir=autoload)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(
                "# Создан dots-nu; удалить для повторной генерации.\n".encode()
            )
            stream.write(result.stdout)
        try:
            os.link(temporary, target)
        except FileExistsError:
            pass
    finally:
        Path(temporary).unlink(missing_ok=True)


def main():
    root = Path(
        os.environ.get("DOTS_ROOT", Path(__file__).resolve().parent.parent)
    ).resolve()
    # GUI запускает shell с минимальным PATH; Homebrew и локальные команды нужны сразу.
    os.environ["PATH"] = os.pathsep.join(
        dict.fromkeys(
            [
                str(Path.home() / ".local/bin"),
                "/opt/homebrew/bin",
                "/opt/homebrew/sbin",
                *os.environ.get("PATH", "").split(os.pathsep),
            ]
        )
    )
    nu = shutil.which("nu")
    if not nu:
        raise RuntimeError("Nushell не найден в PATH")
    cache = (
        Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
        / "dots/zsh-bridge"
    )
    private_dir(cache)
    bindir = cache / "bin"
    private_dir(bindir)
    bridge = root / "scripts/dots-zsh"
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    private = Path(os.environ.get("DOTS_PRIVATE_ZSH", config_home / "dots/private.zsh"))
    inputs = [
        root / "config/zsh/commands.zsh",
        root / "config/zsh/kube-tools.zsh",
        root / "config/shell/codex-proxy.sh",
        root / "scripts/dots-nu",
        bridge,
        private,
        *sorted((root / "config/zsh/functions").glob("*")),
    ]
    signature = []
    for path in inputs:
        try:
            stat = path.stat()
            signature.append([str(path), stat.st_mtime_ns, stat.st_size])
        except FileNotFoundError:
            signature.append([str(path), None, None])
    state_path = cache / "commands.json"
    try:
        state = json.loads(state_path.read_text())
    except (OSError, ValueError):
        state = {}
    if not isinstance(state, dict):
        state = {}
    env = dict(os.environ, DOTS_ROOT=str(root), DOTS_ZSH_BIN=str(bindir))
    if state.get("signature") != signature:
        result = subprocess.run(
            [str(bridge), "--list"], env=env, capture_output=True, text=True, check=True
        )
        names = sorted(
            {
                name
                for name in result.stdout.splitlines()
                if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", name)
                and name not in {"dots-zsh", "dots-nu", "vs"}
            }
        )
        for entry in bindir.iterdir():
            if (
                entry.is_symlink()
                and entry.resolve() == bridge.resolve()
                and entry.name not in names
            ):
                entry.unlink()
        for name in names:
            target = bindir / name
            # Чужие файлы и ссылки не заменяются.
            if not target.exists() and not target.is_symlink():
                target.symlink_to(bridge)
        fd, temporary = tempfile.mkstemp(prefix=".commands-", dir=cache)
        try:
            with os.fdopen(fd, "w") as stream:
                json.dump({"signature": signature}, stream)
            os.replace(temporary, state_path)
        finally:
            Path(temporary).unlink(missing_ok=True)
    env["PATH"] = os.pathsep.join(
        [
            str(bindir),
            *(
                part
                for part in env.get("PATH", "").split(os.pathsep)
                if part != str(bindir)
            ),
        ]
    )
    init_atuin()
    os.execvpe(
        nu, [nu, "--config", str(root / "config/nushell/config.nu"), *sys.argv[1:]], env
    )


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
        print(f"dots-nu: {error}", file=sys.stderr)
        sys.exit(1)
