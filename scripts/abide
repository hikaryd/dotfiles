#!/usr/bin/env bash
# Одинаковое окружение для CLI и хуков из терминала или приложения.
set -Eeuo pipefail

HOOK_MODE=0
if [[ ${1:-} == --hook ]]; then
  HOOK_MODE=1
  shift
  # Хук — необязательная проверка: exit 0 доставляет предупреждение systemMessage,
  # что проверка пропущена, и не блокирует работу агента. Это не успешный вердикт.
  shopt -s execfail
  trap 'printf "%s\n" '\''{"systemMessage":"Abide: hook launch failed. This check was skipped."}'\''; exit 0' ERR
fi

export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"
REPO_DIR="$(cd "$(dirname "$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")")/.." && pwd)"
VERSION="$(cat "$REPO_DIR/config/abide/version")"
PACKAGE_DIR="$HOME/.local/share/dots/abide/$VERSION/node_modules/@coldtea/abide"

if [[ $HOOK_MODE == 1 ]]; then
  SCRIPT="$PACKAGE_DIR/dist/abide-hook.js"
  # Ошибка запуска хука должна оставить агенту диагностическое сообщение.
  if [[ ! -f $SCRIPT ]]; then
    printf '%s\n' '{"systemMessage":"Abide: hook executable is missing; run scripts/abide-apply.py. This check was skipped."}'
    exit 0
  fi
else
  SCRIPT="$PACKAGE_DIR/dist/bin.js"
fi

source "$REPO_DIR/config/shell/codex-proxy.sh"
if ! _codex_proxy_ensure; then
  if [[ $SCRIPT == */abide-hook.js ]]; then
    printf '%s\n' '{"systemMessage":"Abide: local proxy is unavailable. This check was skipped."}'
    exit 0
  fi
  exit 1
fi
export HTTP_PROXY="$CODEX_PROXY_URL" HTTPS_PROXY="$CODEX_PROXY_URL" ALL_PROXY="$CODEX_PROXY_URL"
export http_proxy="$CODEX_PROXY_URL" https_proxy="$CODEX_PROXY_URL" all_proxy="$CODEX_PROXY_URL"
export NO_PROXY="127.0.0.1,localhost,::1,*.local" no_proxy="127.0.0.1,localhost,::1,*.local"
export NODE_USE_ENV_PROXY=1
if [[ $HOOK_MODE == 1 ]]; then
  exec node "$REPO_DIR/scripts/abide-hook-run.mjs" "$SCRIPT" "$@"
fi
exec node "$SCRIPT" "$@"
