#!/usr/bin/python3 -I
import errno
import fcntl
import getpass
import hmac
import http.client
import http.server
import json
import math
import os
from pathlib import Path
import re
import secrets
import select
import signal
import socket
import ssl
import stat
import sys
import tempfile
import threading
import time
import urllib.parse
import warnings

KEY_DIR = '.config/agy'
URL_FILE = 'proxy.url'
KEY_FILE = 'proxy.key'
CONNECT_FILE = 'proxy.connect'
SSH_FILE = 'proxy.ssh'
CONNECT_RE = re.compile(r'^127\.0\.0\.1:([0-9]{1,5})$')
SSH_DEST_RE = re.compile(r'^(?:[A-Za-z0-9._-]+@)?[A-Za-z0-9][A-Za-z0-9.-]*$')
MAX_CONFIG_FILE_BYTES = 4096
TPS_CACHE_DIR = '.cache/agy-statusline'
MAX_REQUEST_BODY = 64 * 1024 * 1024
MAX_SSE_LINE = 2 * 1024 * 1024
ALLOWED_PATH_RE = re.compile(r'^/v1(?:beta)?/')
MODEL_PATH_RE = re.compile(r'^/v1(?:beta)?/models/([^/:?]+)')
DNS_LABEL_RE = re.compile(r'^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$')
HOP_BY_HOP = frozenset({
    'connection',
    'keep-alive',
    'proxy-authenticate',
    'proxy-authorization',
    'te',
    'trailers',
    'transfer-encoding',
    'upgrade',
    'host',
})


def key_dir(home):
    return home / KEY_DIR


def _trim_line_ending(raw):
    if raw.endswith('\r\n'):
        return raw[:-2]
    if raw.endswith('\n'):
        return raw[:-1]
    return raw


def valid_key(key):
    return bool(key) and len(key) <= MAX_CONFIG_FILE_BYTES and all(33 <= ord(c) <= 126 for c in key)


def parse_proxy_url(raw):
    if not isinstance(raw, str):
        return None
    text = _trim_line_ending(raw)
    if not text or len(text) > MAX_CONFIG_FILE_BYTES or any(ord(c) <= 32 or ord(c) >= 127 for c in text):
        return None
    if any(ch in text for ch in '@?#'):
        return None
    if text.endswith('/'):
        text = text[:-1]
    parsed = urllib.parse.urlsplit(text)
    if parsed.scheme != 'https' or parsed.path or parsed.query or parsed.fragment:
        return None
    if not parsed.netloc or parsed.netloc.endswith(':'):
        return None
    host = parsed.hostname
    try:
        port = 443 if parsed.port is None else parsed.port
    except ValueError:
        return None
    if not host or len(host) > 253 or not all(DNS_LABEL_RE.fullmatch(lbl) for lbl in host.split('.')):
        return None
    if not (1 <= port <= 65535):
        return None
    base = f'https://{host}' if port == 443 else f'https://{host}:{port}'
    return base, host, port


def _read_private_file(home, filename):
    directory = key_dir(home)
    flags = os.O_RDONLY | os.O_NOFOLLOW
    try:
        dir_fd = os.open(directory, flags | os.O_DIRECTORY)
    except FileNotFoundError:
        return None
    try:
        info = os.fstat(dir_fd)
        if info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise ValueError('Config directory ~/.config/agy must be owned and 0700')
        fd = os.open(filename, flags, dir_fd=dir_fd)
        try:
            info = os.fstat(fd)
            if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
                raise ValueError(f'File ~/.config/agy/{filename} must be owned and 0600')
            if info.st_size > MAX_CONFIG_FILE_BYTES + 2:
                raise ValueError(f'File ~/.config/agy/{filename} is too large')
            with os.fdopen(fd, 'rb') as source:
                fd = -1
                raw_bytes = source.read(MAX_CONFIG_FILE_BYTES + 3)
        finally:
            if fd != -1:
                os.close(fd)
    except FileNotFoundError:
        return None
    finally:
        os.close(dir_fd)
    if len(raw_bytes) > MAX_CONFIG_FILE_BYTES + 2:
        raise ValueError(f'File ~/.config/agy/{filename} is too large')
    try:
        return _trim_line_ending(raw_bytes.decode('ascii'))
    except UnicodeDecodeError:
        raise ValueError(f'Non-ASCII data in ~/.config/agy/{filename}') from None


def _write_private_file(directory, filename, value):
    fd, tmp_name = tempfile.mkstemp(prefix=f'.{filename}.', dir=directory)
    tmp_path = Path(tmp_name)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as out:
            out.write(value + '\n')
            out.flush()
            os.fsync(out.fileno())
        os.chmod(tmp_path, 0o600)
        tmp_path.replace(directory / filename)
    except BaseException:
        tmp_path.unlink(missing_ok=True)
        raise


def load_proxy_url(home):
    raw = _read_private_file(home, URL_FILE)
    if raw is None:
        return None
    parsed = parse_proxy_url(raw)
    if parsed is None:
        raise ValueError(f'Invalid HTTPS URL in ~/.config/agy/{URL_FILE}')
    return parsed


def load_key(home):
    key = _read_private_file(home, KEY_FILE)
    if key is None:
        return None
    if not valid_key(key):
        raise ValueError(f'Invalid API key in ~/.config/agy/{KEY_FILE}')
    return key


def load_connect(home):
    # Optional loopback endpoint (ssh -L tunnel) dialed instead of the proxy host; TLS still verifies the proxy host.
    raw = _read_private_file(home, CONNECT_FILE)
    if raw is None:
        return None
    m = CONNECT_RE.fullmatch(raw)
    if not m or not 1 <= int(m.group(1)) <= 65535:
        raise ValueError(f'~/.config/agy/{CONNECT_FILE} must be 127.0.0.1:<port>')
    return '127.0.0.1', int(m.group(1))


def run_tunnel(home):
    dest = _read_private_file(home, SSH_FILE)
    connect = load_connect(home)
    proxy = load_proxy_url(home)
    if dest is None or connect is None or proxy is None:
        return
    if not SSH_DEST_RE.fullmatch(dest):
        raise ValueError(f'Invalid ssh destination in ~/.config/agy/{SSH_FILE}')
    _, host, port = proxy
    os.execv('/usr/bin/ssh', [
        'ssh', '-N', '-o', 'BatchMode=yes', '-o', 'ExitOnForwardFailure=yes',
        '-o', 'ServerAliveInterval=15', '-o', 'ServerAliveCountMax=3',
        '-L', f'{connect[0]}:{connect[1]}:{host}:{port}', '--', dest,
    ])


def configure_proxy(home, install=False):
    existing_url = load_proxy_url(home)
    existing_key = load_key(home)
    if existing_url and existing_key:
        return existing_url, existing_key
    if not (sys.stdin.isatty() and sys.stderr.isatty()):
        if install:
            print('URL прокси и API-ключ будут запрошены при первом запуске agy в терминале.', file=sys.stderr)
            return None, None
        raise ValueError(
            f'Сохраните HTTPS URL в ~/.config/agy/{URL_FILE} и API-ключ в ~/.config/agy/{KEY_FILE} (0600) '
            'или запустите agy в терминале.'
        )
    directory = key_dir(home)
    directory.mkdir(parents=True, mode=0o700, exist_ok=True)
    dir_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        info = os.fstat(dir_fd)
        if info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise ValueError('Config directory ~/.config/agy must be owned and 0700')
        fcntl.flock(dir_fd, fcntl.LOCK_EX)
        existing_url = load_proxy_url(home)
        existing_key = load_key(home)
        if not existing_url:
            try:
                sys.stderr.write('HTTPS URL прокси для agy (например, https://proxy.example.com): ')
                sys.stderr.flush()
                raw_url = sys.stdin.readline()
            except KeyboardInterrupt:
                raise ValueError('Ввод отменён. Настройки прокси не сохранены.') from None
            if not raw_url:
                raise ValueError('Ввод отменён. Настройки прокси не сохранены.')
            parsed = parse_proxy_url(_trim_line_ending(raw_url).strip(' '))
            if parsed is None:
                raise ValueError('Некорректный URL прокси (ожидается https://<host> без пути).')
            _write_private_file(directory, URL_FILE, parsed[0])
            existing_url = parsed
        if not existing_key:
            with warnings.catch_warnings():
                warnings.simplefilter('error', getpass.GetPassWarning)
                try:
                    key = _trim_line_ending(getpass.getpass(f'API-ключ для {existing_url[0]} (ввод скрыт): '))
                except (getpass.GetPassWarning, KeyboardInterrupt, EOFError):
                    raise ValueError('Ввод отменён. Ключ не сохранён.') from None
            if not valid_key(key):
                raise ValueError('Некорректный формат API-ключа (ожидаются видимые ASCII-символы).')
            _write_private_file(directory, KEY_FILE, key)
            existing_key = key
            print(f'Настройки прокси ({existing_url[0]}) сохранены.', file=sys.stderr)
        return existing_url, existing_key
    finally:
        os.close(dir_fd)


def _slug(text):
    if not isinstance(text, str):
        return ''
    return re.sub(r'[^a-z0-9.]+', '-', text.lower()).strip('-')


def _int_ge0(value):
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return 0
    if not math.isfinite(value) or value <= 0:
        return 0
    return int(value)


def _ensure_tps_dir(home):
    cache_dir = home / TPS_CACHE_DIR
    cache_dir.mkdir(parents=True, mode=0o700, exist_ok=True)
    dir_fd = os.open(cache_dir, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        info = os.fstat(dir_fd)
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
            raise OSError('Unsafe cache directory')
        os.fchmod(dir_fd, 0o700)
    finally:
        os.close(dir_fd)
    return cache_dir


def _cleanup_stale_live_files(cache_dir):
    try:
        entries = list(cache_dir.iterdir())
    except OSError:
        return
    for entry in entries:
        m = re.fullmatch(r'live-(\d+)\.json', entry.name)
        m_tmp = None if m else re.fullmatch(r'\.live-(\d+)\.json\.(\d+)\.tmp', entry.name)
        if not m and not m_tmp:
            continue
        pids = [int(m.group(1))] if m else [int(m_tmp.group(1)), int(m_tmp.group(2))]
        if os.getpid() in pids:
            continue
        all_dead = True
        for pid in pids:
            try:
                os.kill(pid, 0)
                all_dead = False
                break
            except ProcessLookupError:
                continue
            except OSError:
                all_dead = False
                break
        if all_dead:
            try:
                entry.unlink()
            except OSError:
                pass


def _token_matches(candidate, expected):
    return hmac.compare_digest(candidate.encode('utf-8', 'surrogatepass'), expected.encode('utf-8'))


def _is_safe_api_path(raw_path):
    if not raw_path:
        return False
    cur = raw_path
    for _ in range(3):
        if '\\' in cur or '\x00' in cur or '//' in cur:
            return False
        if any(seg in ('.', '..') for seg in cur.split('/')):
            return False
        if not ALLOWED_PATH_RE.match(cur):
            return False
        nxt = urllib.parse.unquote(cur)
        if nxt == cur:
            return True
        cur = nxt
    return False


class _TpsStore:
    def __init__(self, cache_dir, filename, agy_pid):
        self._cache_dir = cache_dir
        self._filename = filename
        self._agy_pid = agy_pid
        self._lock = threading.Lock()
        self._closed = False
        self._models = {}
        self._cpt = {}

    def chars_per_token(self, model):
        with self._lock:
            return self._cpt.get(model, 3.8)

    def update(self, model, entry, new_cpt=None):
        if not model:
            return
        with self._lock:
            if self._closed:
                return
            if new_cpt is not None:
                prev = self._cpt.get(model, 3.8)
                self._cpt[model] = 0.7 * prev + 0.3 * new_cpt
            self._models[model] = entry
            snapshot = {'pid': self._agy_pid, 'models': dict(self._models)}
            self._write_locked(snapshot)

    def mark_not_live(self, model, updated_mono):
        if not model:
            return
        with self._lock:
            if self._closed:
                return
            cur = self._models.get(model)
            if isinstance(cur, dict) and cur.get('live') is True and cur.get('updated_mono') == updated_mono:
                updated = dict(cur)
                updated['live'] = False
                updated['updated_wall'] = time.time()
                self._models[model] = updated
                self._write_locked({'pid': self._agy_pid, 'models': dict(self._models)})

    def _write_locked(self, snapshot):
        payload = json.dumps(snapshot, separators=(',', ':')).encode('utf-8')
        tmp = f'.{self._filename}.{os.getpid()}.tmp'
        dir_fd = -1
        try:
            dir_fd = os.open(self._cache_dir, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
            info = os.fstat(dir_fd)
            if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
                return
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600, dir_fd=dir_fd)
            try:
                with os.fdopen(fd, 'wb') as out:
                    fd = -1
                    out.write(payload)
            finally:
                if fd != -1:
                    os.close(fd)
            os.replace(tmp, self._filename, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
        except OSError:
            if dir_fd != -1:
                try:
                    os.unlink(tmp, dir_fd=dir_fd)
                except OSError:
                    pass
        finally:
            if dir_fd != -1:
                os.close(dir_fd)

    def close_and_remove(self):
        with self._lock:
            self._closed = True
            dir_fd = -1
            try:
                dir_fd = os.open(self._cache_dir, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
                for name in (self._filename, f'.{self._filename}.{os.getpid()}.tmp'):
                    try:
                        os.unlink(name, dir_fd=dir_fd)
                    except OSError:
                        pass
            except OSError:
                pass
            finally:
                if dir_fd != -1:
                    os.close(dir_fd)


class _StreamMeter:
    def __init__(self, store, model_slug, t_req):
        self._store = store
        self._model = model_slug
        self._t_req = t_req
        self._t_first = None
        self._t_last = None
        self._exact_tokens = 0
        self._est_chars = 0
        self._last_flush = 0.0
        self._buf = bytearray()
        self._overflow = False
        self._cpt = store.chars_per_token(model_slug) if model_slug else 3.8

    def feed(self, data):
        if not data:
            return
        for part in data.splitlines(keepends=True):
            ends_line = part.endswith((b'\n', b'\r'))
            if self._overflow:
                if ends_line:
                    self._overflow = False
                    self._buf.clear()
                continue
            if len(self._buf) + len(part) > MAX_SSE_LINE:
                self._buf.clear()
                self._overflow = not ends_line
                continue
            self._buf.extend(part)
            if ends_line:
                line = bytes(self._buf).strip()
                self._buf.clear()
                if line:
                    self._handle_line(line)

    def _handle_line(self, raw_line):
        if not raw_line.startswith(b'data:'):
            return
        payload = raw_line[5:].strip()
        if not payload or payload == b'[DONE]':
            return
        try:
            obj = json.loads(payload.decode('utf-8', 'replace'))
        except (ValueError, RecursionError):
            return
        if not isinstance(obj, dict):
            return

        if not self._model:
            raw_model = obj.get('model') or obj.get('modelVersion')
            if isinstance(raw_model, str) and raw_model:
                self._model = _slug(raw_model)
                if self._model:
                    self._cpt = self._store.chars_per_token(self._model)

        chars_added = 0
        candidates = obj.get('candidates')
        if isinstance(candidates, list):
            for cand in candidates:
                if not isinstance(cand, dict):
                    continue
                content = cand.get('content')
                parts = content.get('parts') if isinstance(content, dict) else None
                if isinstance(parts, list):
                    for p in parts:
                        if not isinstance(p, dict):
                            continue
                        txt = p.get('text')
                        if isinstance(txt, str):
                            chars_added += len(txt)
                        fc = p.get('functionCall')
                        if isinstance(fc, dict):
                            try:
                                chars_added += len(json.dumps(fc, separators=(',', ':')))
                            except (TypeError, ValueError):
                                pass

        choices = obj.get('choices')
        if isinstance(choices, list):
            for ch in choices:
                if not isinstance(ch, dict):
                    continue
                delta = ch.get('delta')
                if isinstance(delta, dict):
                    for key in ('content', 'reasoning_content', 'reasoning'):
                        txt = delta.get(key)
                        if isinstance(txt, str):
                            chars_added += len(txt)
                    tcs = delta.get('tool_calls')
                    if isinstance(tcs, list):
                        try:
                            chars_added += len(json.dumps(tcs, separators=(',', ':')))
                        except (TypeError, ValueError):
                            pass

        exact = 0
        um = obj.get('usageMetadata')
        if isinstance(um, dict):
            cand_tok = _int_ge0(um.get('candidatesTokenCount'))
            thought_tok = _int_ge0(um.get('thoughtsTokenCount'))
            tot_tok = _int_ge0(um.get('totalTokenCount'))
            prompt_tok = _int_ge0(um.get('promptTokenCount'))
            if cand_tok > 0 and thought_tok > 0 and tot_tok > 0 and prompt_tok > 0:
                if prompt_tok + cand_tok + thought_tok <= tot_tok + 5:
                    exact = cand_tok + thought_tok
                else:
                    exact = max(cand_tok, thought_tok)
            else:
                exact = cand_tok + thought_tok
        else:
            usage = obj.get('usage')
            if isinstance(usage, dict):
                exact = _int_ge0(usage.get('completion_tokens') or usage.get('output_tokens'))

        if chars_added > 0 or exact > 0:
            now = time.monotonic()
            if self._t_first is None:
                self._t_first = now
            self._t_last = now
            self._est_chars += chars_added
            if exact > self._exact_tokens:
                self._exact_tokens = exact
            if now - self._last_flush >= 0.25:
                self._publish(live=True, now_mono=now)

    def _publish(self, live, now_mono):
        if not self._model or self._t_first is None or self._t_last is None:
            return False
        tokens = float(self._exact_tokens) if self._exact_tokens > 0 else (self._est_chars / self._cpt)
        if tokens < 5.0:
            return False
        dt = self._t_last - self._t_first
        if dt < 0.15:
            if not live and self._exact_tokens >= 5 and (self._t_last - self._t_req) >= 0.15:
                dt = self._t_last - self._t_req
            else:
                return False
        tps = tokens / dt
        if not math.isfinite(tps) or not (0.0 < tps <= 5000.0):
            return False
        new_cpt = None
        if not live and self._exact_tokens >= 10 and self._est_chars >= 20:
            new_cpt = max(1.5, min(8.0, self._est_chars / self._exact_tokens))
        entry = {
            'tps': round(tps, 2),
            'live': live,
            'exact': self._exact_tokens > 0,
            'tokens': int(round(tokens)),
            'ttft_ms': int(round(max(0.0, (self._t_first - self._t_req) * 1000.0))),
            'updated_wall': time.time(),
            'updated_mono': now_mono,
        }
        self._last_flush = now_mono
        self._store.update(self._model, entry, new_cpt=new_cpt)
        return True

    def finish(self):
        if self._buf and not self._overflow:
            line = bytes(self._buf).strip()
            self._buf.clear()
            if line:
                self._handle_line(line)
        prev_flush = self._last_flush
        if not self._publish(live=False, now_mono=time.monotonic()) and prev_flush > 0.0:
            self._store.mark_not_live(self._model, prev_flush)


def _read_request_body(handler):
    te_values = handler.headers.get_all('Transfer-Encoding') or []
    cl_values = handler.headers.get_all('Content-Length') or []
    if te_values and cl_values:
        return None
    if te_values:
        te_tokens = [t.strip().lower() for h in te_values for t in h.split(',') if t.strip()]
        if te_tokens != ['chunked']:
            return None
        out = bytearray()
        while True:
            size_line = handler.rfile.readline(4096)
            if not size_line or not size_line.endswith(b'\n'):
                return None
            try:
                chunk_size = int(size_line.split(b';', 1)[0].strip(), 16)
            except ValueError:
                return None
            if chunk_size < 0 or len(out) + chunk_size > MAX_REQUEST_BODY:
                return None
            if chunk_size == 0:
                while True:
                    trailer = handler.rfile.readline(4096)
                    if not trailer or not trailer.endswith(b'\n'):
                        return None
                    if trailer in (b'\r\n', b'\n'):
                        return bytes(out)
            chunk = handler.rfile.read(chunk_size)
            if len(chunk) != chunk_size:
                return None
            out.extend(chunk)
            crlf = handler.rfile.read(2)
            if crlf != b'\r\n':
                return None
    if not cl_values:
        return b''
    parsed_lengths = set()
    for raw_len in cl_values:
        try:
            val = int(raw_len.strip())
        except ValueError:
            return None
        if val < 0 or val > MAX_REQUEST_BODY:
            return None
        parsed_lengths.add(val)
    if len(parsed_lengths) != 1:
        return None
    length = next(iter(parsed_lengths))
    if length == 0:
        return b''
    body = handler.rfile.read(length)
    return body if len(body) == length else None


def _start_meter_sidecar(home, upstream_host, upstream_port, upstream_key, local_token, agy_pid, connect_addr=None):
    cache_dir = _ensure_tps_dir(home)
    _cleanup_stale_live_files(cache_dir)
    tps_filename = f'live-{agy_pid}.json'
    tps_path = cache_dir / tps_filename

    ready_r, ready_w = os.pipe()
    mid_pid = os.fork()
    if mid_pid > 0:
        os.close(ready_w)
        daemon_pid = None
        try:
            os.waitpid(mid_pid, 0)
            raw = b''
            deadline = time.monotonic() + 2.0
            while raw.count(b'\n') < 2 and len(raw) < 128:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    break
                rlist, _, _ = select.select([ready_r], [], [], remaining)
                if not rlist:
                    break
                chunk = os.read(ready_r, 128 - len(raw))
                if not chunk:
                    break
                raw += chunk
            lines = raw.decode('ascii', 'replace').splitlines()
            port = None
            for line in lines:
                if line.startswith('pid:') and line[4:].isdigit():
                    daemon_pid = int(line[4:])
                elif line.startswith('port:') and line[5:].isdigit():
                    port = int(line[5:])
            if port is not None and 1 <= port <= 65535:
                return port, tps_path
            if daemon_pid:
                try:
                    os.kill(daemon_pid, signal.SIGKILL)
                except OSError:
                    pass
            return None, None
        except (OSError, ValueError):
            if daemon_pid:
                try:
                    os.kill(daemon_pid, signal.SIGKILL)
                except OSError:
                    pass
            return None, None
        finally:
            os.close(ready_r)

    # Intermediate child: double-fork so sidecar is reparented to init (never a zombie under agy).
    os.close(ready_r)
    try:
        os.setsid()
        daemon_pid = os.fork()
        if daemon_pid > 0:
            try:
                os.write(ready_w, f'pid:{daemon_pid}\n'.encode('ascii'))
            finally:
                os.close(ready_w)
            os._exit(0)
    except BaseException:
        try:
            os.close(ready_w)
        except OSError:
            pass
        os._exit(0)

    try:
        devnull = os.open(os.devnull, os.O_RDWR)
        try:
            for fd in (0, 1, 2):
                os.dup2(devnull, fd)
        finally:
            if devnull > 2:
                os.close(devnull)

        store = _TpsStore(cache_dir, tps_filename, agy_pid)
        ssl_ctx = ssl.create_default_context()

        class _MeterServer(http.server.ThreadingHTTPServer):
            allow_reuse_address = True
            daemon_threads = True

        class _ProxyHandler(http.server.BaseHTTPRequestHandler):
            protocol_version = 'HTTP/1.1'

            def log_message(self, fmt, *args):
                return

            def _send_err(self, status, msg):
                body = json.dumps({'error': msg}).encode('utf-8')
                self.close_connection = True
                self.send_response(status)
                self.send_header('Content-Type', 'application/json')
                self.send_header('Content-Length', str(len(body)))
                self.send_header('Connection', 'close')
                self.end_headers()
                try:
                    self.wfile.write(body)
                    self.wfile.flush()
                except OSError:
                    pass

            def _handle_proxy(self, method):
                parsed = urllib.parse.urlsplit(self.path)
                if not _is_safe_api_path(parsed.path):
                    self._send_err(403, 'forbidden path')
                    return

                authed = False
                fwd_headers = {}
                conn_tokens = {
                    t.strip().lower()
                    for h in self.headers.get_all('Connection') or []
                    for t in h.split(',')
                    if t.strip()
                }
                for name, value in self.headers.items():
                    low = name.lower()
                    if low in HOP_BY_HOP or low in conn_tokens or low in ('content-length', 'accept-encoding'):
                        continue
                    if low == 'x-goog-api-key':
                        if _token_matches(value.strip(), local_token):
                            authed = True
                            fwd_headers[name] = upstream_key
                        else:
                            self._send_err(401, 'unauthorized')
                            return
                        continue
                    if low == 'authorization' and value.lower().startswith('bearer '):
                        tok = value[7:].strip()
                        if _token_matches(tok, local_token):
                            authed = True
                            fwd_headers[name] = f'Bearer {upstream_key}'
                        else:
                            self._send_err(401, 'unauthorized')
                            return
                        continue
                    fwd_headers[name] = value

                query = parsed.query
                if query:
                    q_pairs = urllib.parse.parse_qsl(query, keep_blank_values=True)
                    new_pairs = []
                    for k, v in q_pairs:
                        if k == 'key':
                            if _token_matches(v, local_token):
                                authed = True
                                new_pairs.append((k, upstream_key))
                            else:
                                self._send_err(401, 'unauthorized')
                                return
                        else:
                            new_pairs.append((k, v))
                    query = urllib.parse.urlencode(new_pairs)

                if not authed:
                    self._send_err(401, 'unauthorized')
                    return

                body = _read_request_body(self)
                if body is None:
                    self._send_err(400, 'invalid request body')
                    return

                fwd_headers['Host'] = upstream_host if upstream_port == 443 else f'{upstream_host}:{upstream_port}'
                fwd_headers['Accept-Encoding'] = 'identity'
                fwd_headers['Connection'] = 'close'
                if body or method in ('POST', 'PUT', 'PATCH'):
                    fwd_headers['Content-Length'] = str(len(body))

                upstream_target = parsed.path + (f'?{query}' if query else '')
                is_stream_req = ':streamGenerateContent' in parsed.path or 'alt=sse' in query.lower()
                m_match = MODEL_PATH_RE.match(parsed.path)
                model_slug = _slug(urllib.parse.unquote(m_match.group(1))) if m_match else ''

                t_req = time.monotonic()
                conn = http.client.HTTPSConnection(upstream_host, upstream_port, timeout=300, context=ssl_ctx)
                if connect_addr:
                    conn._create_connection = lambda _addr, *a, **kw: socket.create_connection(connect_addr, *a, **kw)
                try:
                    conn.request(method, upstream_target, body=body if body else None, headers=fwd_headers)
                    resp = conn.getresponse()
                except (OSError, http.client.HTTPException):
                    conn.close()
                    self._send_err(502, 'upstream error')
                    return

                try:
                    resp_ct = (resp.getheader('Content-Type') or '').lower()
                    is_sse = resp.status == 200 and ('text/event-stream' in resp_ct or is_stream_req)
                    no_body = method == 'HEAD' or resp.status in (204, 304) or (100 <= resp.status < 200)
                    resp_conn_tokens = {
                        t.strip().lower()
                        for h in resp.headers.get_all('Connection') or []
                        for t in h.split(',')
                        if t.strip()
                    }
                    resp_cl = None if (is_sse or no_body or resp.chunked) else resp.getheader('Content-Length')
                    use_chunked = not no_body and (is_sse or resp.chunked or resp_cl is None)

                    self.close_connection = True
                    self.send_response(resp.status, resp.reason)
                    for name, value in resp.getheaders():
                        low = name.lower()
                        if low in HOP_BY_HOP or low in resp_conn_tokens:
                            continue
                        if low == 'content-length' and (is_sse or use_chunked):
                            continue
                        self.send_header(name, value)
                    if use_chunked:
                        self.send_header('Transfer-Encoding', 'chunked')
                    self.send_header('Connection', 'close')
                    self.end_headers()

                    if no_body:
                        resp.read()
                        return

                    meter = _StreamMeter(store, model_slug, t_req) if is_sse else None
                    finished = False
                    try:
                        while True:
                            chunk = resp.read1(4096)
                            if not chunk:
                                break
                            if use_chunked:
                                self.wfile.write(f'{len(chunk):x}\r\n'.encode('ascii'))
                                self.wfile.write(chunk)
                                self.wfile.write(b'\r\n')
                            else:
                                self.wfile.write(chunk)
                            self.wfile.flush()
                            if meter is not None:
                                meter.feed(chunk)
                        if meter is not None:
                            meter.finish()
                            finished = True
                        # Do not emit a clean chunked EOF if a Content-Length upstream truncated early.
                        if use_chunked and (resp.chunked or resp.length in (None, 0)):
                            self.wfile.write(b'0\r\n\r\n')
                            self.wfile.flush()
                    except (BrokenPipeError, ConnectionResetError, OSError):
                        pass
                    finally:
                        if meter is not None and not finished:
                            meter.finish()
                finally:
                    conn.close()

            def do_GET(self):
                self._handle_proxy('GET')

            def do_POST(self):
                self._handle_proxy('POST')

            def do_PUT(self):
                self._handle_proxy('PUT')

            def do_PATCH(self):
                self._handle_proxy('PATCH')

            def do_DELETE(self):
                self._handle_proxy('DELETE')

            def do_OPTIONS(self):
                self._handle_proxy('OPTIONS')

            def do_HEAD(self):
                self._handle_proxy('HEAD')

        server = _MeterServer(('127.0.0.1', 0), _ProxyHandler)
        port = server.server_address[1]
        os.write(ready_w, f'port:{port}\n'.encode('ascii'))
        os.close(ready_w)
        ready_w = -1

        def _poll_parent_exit():
            while True:
                time.sleep(1.0)
                try:
                    os.kill(agy_pid, 0)
                except ProcessLookupError:
                    break
                except OSError:
                    pass

        def _watch_parent():
            try:
                kq = select.kqueue()
                ev = select.kevent(
                    agy_pid,
                    filter=select.KQ_FILTER_PROC,
                    flags=select.KQ_EV_ADD | select.KQ_EV_ONESHOT,
                    fflags=select.KQ_NOTE_EXIT,
                )
                try:
                    events = kq.control([ev], 1)
                    if events and (events[0].flags & select.KQ_EV_ERROR):
                        if events[0].data != errno.ESRCH:
                            _poll_parent_exit()
                except OSError as exc:
                    if exc.errno != errno.ESRCH:
                        _poll_parent_exit()
                finally:
                    kq.close()
            finally:
                store.close_and_remove()
                try:
                    server.shutdown()
                except Exception:
                    pass
                os._exit(0)

        threading.Thread(target=_watch_parent, daemon=True).start()
        server.serve_forever(poll_interval=0.5)
    except BaseException:
        pass
    finally:
        if ready_w != -1:
            try:
                os.close(ready_w)
            except OSError:
                pass
        os._exit(0)


def launch(home, proxy_info, key, arguments):
    if any(arg in ('--settings', '-settings') or arg.startswith(('--settings=', '-settings=')) for arg in arguments):
        raise ValueError('--settings is reserved for the proxy provider')
    binary = home / '.local/bin/agy'
    if not binary.is_file() or not os.access(binary, os.X_OK):
        raise ValueError('Original ~/.local/bin/agy is not installed')
    base_url, upstream_host, upstream_port = proxy_info
    env = os.environ.copy()
    for conflict in ('GOOGLE_API_KEY', 'GOOGLE_GENAI_USE_VERTEXAI', 'GOOGLE_GENAI_USE_ENTERPRISE', 'GOOGLE_VERTEX_BASE_URL'):
        env.pop(conflict, None)

    local_token = secrets.token_urlsafe(32)
    connect_addr = load_connect(home)
    port, tps_path = None, None
    try:
        port, tps_path = _start_meter_sidecar(home, upstream_host, upstream_port, key, local_token, os.getpid(), connect_addr)
    except OSError:
        port, tps_path = None, None
    if connect_addr and port is None:
        raise ValueError('Local proxy failed to start; direct path bypasses ~/.config/agy/proxy.connect')

    if port is not None and tps_path is not None:
        env['GEMINI_API_KEY'] = local_token
        env['GOOGLE_GEMINI_BASE_URL'] = f'http://127.0.0.1:{port}'
        env['AGY_TPS_FILE'] = str(tps_path)
    else:
        env['GEMINI_API_KEY'] = key
        env['GOOGLE_GEMINI_BASE_URL'] = base_url
        env.pop('AGY_TPS_FILE', None)

    command = [str(binary), '--dangerously-skip-permissions', '--settings', '{"modelProvider":"gemini"}', *arguments]
    os.execve(str(binary), command, env)


def main():
    home = Path.home()
    if sys.argv[1:] == ['--dots-service']:
        return
    if sys.argv[1:] == ['--dots-tunnel']:
        run_tunnel(home)
        return
    if sys.argv[1:] == ['--dots-init-proxy']:
        configure_proxy(home, install=True)
        return
    proxy_info, key = configure_proxy(home, install=False)
    launch(home, proxy_info, key, sys.argv[1:])


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError) as error:
        message = str(error) if type(error) is ValueError else 'Proxy setup or agy launch failed'
        print(f'agy-manager: {message}', file=sys.stderr)
        sys.exit(1)
