#!/bin/sh
set -eu
# Keep the user's trial daemon and all its PTYs when promoting it to daily use.
# The profile owns only mux config/state, never application credentials/history.
data=${XDG_DATA_HOME:-$HOME/.local/share}
profile=${DOTS_TUIOS_PROFILE:-$data/dots/tuios/profile}
binary="$data/dots/tuios/0.11.0/tuios"
if [ ! -x "$binary" ]; then
  printf 'TUIOS 0.11.0 is not installed. Run: ~/dots/scripts/install-tuios.sh\n' >&2
  exit 127
fi
server=dots
if [ -f "$profile/server" ]; then IFS= read -r server < "$profile/server"; fi
case "$server" in ''|*[!a-zA-Z0-9_-]*) printf 'Invalid TUIOS profile server\n' >&2; exit 1 ;; esac
# Do not replace the original paths again when a pane starts another command.
export DOTS_TUIOS_XDG_CONFIG_HOME="${DOTS_TUIOS_XDG_CONFIG_HOME-${XDG_CONFIG_HOME:-$HOME/.config}}"
export DOTS_TUIOS_XDG_STATE_HOME="${DOTS_TUIOS_XDG_STATE_HOME-${XDG_STATE_HOME:-$HOME/.local/state}}"
export DOTS_TUIOS_XDG_RUNTIME_DIR="${DOTS_TUIOS_XDG_RUNTIME_DIR-${XDG_RUNTIME_DIR-}}"
export DOTS_TUIOS_PROFILE="$profile"
export XDG_CONFIG_HOME="$profile/config" XDG_STATE_HOME="$profile/state" XDG_RUNTIME_DIR="$profile/run"
export TUIOS_SERVER="${TUIOS_SERVER:-$server}"
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
export SHELL="$HOME/.local/bin/dots-tuios-shell"
exec "$binary" "$@"
