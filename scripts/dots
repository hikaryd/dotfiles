#!/usr/bin/env python3
"""Небольшое меню существующего рабочего окружения, без фоновых служб."""

import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def run(argv):
    try:
        return subprocess.run(argv, check=False).returncode
    except FileNotFoundError:
        print(f"Не найдена команда: {argv[0]}", file=sys.stderr)
        return 127


def pick(title, choices):
    """Возвращает только известный ключ, а не выполняемый ввод пользователя."""
    labels = [f"{key} · {label}" for key, label in choices.items()]
    if shutil.which("gum"):
        argv = ["gum", "filter", "--placeholder", title, "--no-sort", "--limit", "1"]
    elif shutil.which("fzf"):
        argv = ["fzf", "--prompt", f"{title}> ", "--no-multi"]
    else:
        print("Для меню нужен gum или fzf.", file=sys.stderr)
        return None
    result = subprocess.run(
        argv,
        check=False,
        input="\n".join(labels) + "\n",
        text=True,
        stdout=subprocess.PIPE,
    )
    if result.returncode or result.stdout.strip() not in labels:
        return None
    return result.stdout.strip().split(" · ", 1)[0]


def kube():
    environment = pick(
        "Окружение Kubernetes",
        {
            "dev": "DEV",
            "stage": "STAGE",
            "preprod": "PREPROD",
            "prod": "PROD · только чтение",
        },
    )
    if not environment:
        return 0
    action = pick(
        "Read-only действие",
        {
            "pods": "Список pod",
            "logs": "Выбрать pod и открыть логи",
            "watch": "Наблюдать workload",
            "analyze": "CPU/RAM и состояние pod",
        },
    )
    if not action:
        return 0
    prefix = {
        "dev": "kpdev",
        "stage": "kpstage",
        "preprod": "kppreprod",
        "prod": "kpprod",
    }[environment]
    suffix = {
        "pods": "",
        "logs": "-logs",
        "watch": "-deploy-watch",
        "analyze": "-pod-analyze",
    }[action]
    # Не eval: только выбранная из whitelist функция, аргументы отдельными argv.
    script = """
DOTS_PRIVATE_ZSH="${DOTS_PRIVATE_ZSH:-${XDG_CONFIG_HOME:-$HOME/.config}/dots/private.zsh}"
[[ -r "$DOTS_PRIVATE_ZSH" ]] && source "$DOTS_PRIVATE_ZSH"
source "$1/config/zsh/kube-tools.zsh"
shift
"$@"
"""
    return run(
        [
            shutil.which("zsh") or "zsh",
            "-f",
            "-c",
            script,
            "dots-kube",
            str(ROOT),
            prefix + suffix,
            *(["get", "pods"] if action == "pods" else []),
        ]
    )


def menu():
    choice = pick(
        "dots · текущий проект",
        {
            "projects": "Рабочие пространства",
            "status": "Состояние проектов · Git / процессы / порты",
            "refs": "Ссылки, request-id и file:line из текущей панели",
            "clip": "Буфер обмена · JSON / Base64 / JWT / время",
            "git": "LazyGit здесь",
            "kube": "Kubernetes · read-only",
            "ports": "Кто слушает локальные TCP-порты",
            "style": "Glass / Focus / Presentation",
            "config": "Открыть конфиг",
            "doctor": "Проверить сетап",
            "help": "Шпаргалка",
        },
    )
    if not choice:
        return 0
    if choice == "projects":
        return main(["projects", "open"])
    if choice == "status":
        return main(["status", "--interactive"] if sys.stdin.isatty() else ["status"])
    if choice == "git":
        return run(["lazygit"])
    if choice == "kube":
        return kube()
    if choice == "ports":
        return main(["ports"])
    if choice == "style":
        style = pick(
            "Стиль",
            {
                "glass": "Текущее стекло",
                "focus": "Без прозрачности и движения",
                "presentation": "Крупнее, без путей в prompt",
            },
        )
        return main(["style", style]) if style else 0
    if choice == "config":
        configs = {
            "zsh": "config/zsh/.zshrc",
            "tmux": "config/tmux/tmux.conf",
            "ghostty": "config/ghostty/config",
            "nvim": "config/nvim/init.lua",
            "sesh": "config/sesh/sesh.toml",
            "atuin": "config/atuin/config.toml",
        }
        selected = pick("Редактировать конфиг", configs)
        return run(["nvim", str(ROOT / configs[selected])]) if selected else 0
    return main([choice])


def main(args=None):
    args = list(sys.argv[1:] if args is None else args)
    command = args.pop(0) if args else "menu"
    if command in {
        "projects",
        "style",
        "doctor",
        "notify",
        "refs",
        "clip",
        "status",
        "private",
    }:
        extra = {
            "projects": ["open"],
            "style": ["status"],
            "doctor": [],
            "notify": ["--help"],
            "refs": [],
            "clip": [],
            "status": [],
            "private": ["check"],
        }
        return run(
            [
                sys.executable,
                str(ROOT / "scripts" / f"dots-{command}.py"),
                *(args or extra[command]),
            ]
        )
    if command == "menu":
        return menu()
    if command == "ports":
        status = run(["lsof", "-nP", "-iTCP", "-sTCP:LISTEN"])
        return 0 if status == 1 else status
    if command == "kube":
        return kube()
    if command in {"help", "--help", "-h"}:
        print("""dots menu                  меню действий (zsh Ctrl+O; tmux prefix O)
dots projects open         выбрать проект (tmux prefix P)
dots projects list         обнаруженные проекты; --json для скриптов
dots projects refresh      обновить приватный inventory из живых сессий/worktree
dots status [--all] [--json] Git / процессы / local listeners; --interactive для r/o/q
dots refs                  извлечь ссылки/ID/file:line из панели; --list без действий
dots clip                  JSON / Base64 / JWT / time / redact; запись с подтверждением
dots clip json --stdout    preview в stdout, без перезаписи clipboard
dots style glass|focus|presentation   переключить оформление
dots style status         текущий профиль
dots doctor [--json] [--strict]       read-only проверка сетапа
dots private init|check   подготовить/проверить приватные файлы без вывода секретов
dots ports                слушающие TCP-порты, без kill
dots kube                 Kubernetes: только read-only меню
dots notify --test        тест доставки уведомления

Ctrl+R — локальная история Atuin; Up и остальные fzf-клавиши сохранены.
tmux: prefix = Ctrl+A; T — sesh; P — проекты; O — меню; F — refs; Y — clipboard; V — status.
Presentation скрывает prompt/status identifiers, НЕ содержимое буфера/scrollback.
Существующие проекты/сессии не перезапускаются. Логи новых workspace — пустой shell.
""")
        return 0
    print(f"Неизвестная команда: {command}; dots help", file=sys.stderr)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
