#!/bin/sh
set -eu
# A GUI launched from a pane is a new outer client, never that pane itself.
# Ghostty may retain Nushell integration in an already-running app. This exact
# bootstrap belongs inside Nu, not on a multiplexer command line.
if [ "$#" -eq 2 ] && [ "$1" = --execute ] && [ "$2" = 'use ghostty *' ]; then shift 2; fi
for name in $(/usr/bin/env | /usr/bin/awk -F= '/^(TMUX|DOTS_SOURCE_PANE=|DOTS_MUX_CLIENT=)/ { print $1 }'); do
  unset "$name"
done
# Popup jobs inherit the server environment, not dots-nu's expanded pane PATH.
PATH="$HOME/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:${PATH:-/usr/bin:/bin}"
export PATH
if [ "$#" -gt 0 ]; then exec tmux "$@"; fi
# Attach the most recent session; "main" exists only to start an empty server.
if tmux has-session 2>/dev/null; then exec tmux attach-session; fi
exec tmux new-session -s main
